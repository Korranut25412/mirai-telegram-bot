# คัดลอกไฟล์นี้เป็น .env แล้วกรอกเอง (ห้ามส่ง .env ให้ใคร)

# token จาก @BotFather (หน้าตาแบบ 123456789:AAxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# chat id ของเรา ปล่อยว่างไว้ก่อน รันบอทแล้วทักบอท มันจะบอกเลขให้ แล้วค่อยมาใส่
# หลายคนคั่นด้วยจุลภาค เช่น 111,222
ALLOWED_CHAT_IDS=

# เวลาส่งสรุปข่าวเช้าทุกวัน (HH:MM) ปล่อยว่าง = ปิด
DAILY_TIME=07:00
# ถ้าคอมปิดอยู่ตอนถึงเวลา เปิดเครื่องภายในกี่ชั่วโมงยังส่งย้อนหลังให้
DAILY_CATCHUP_HOURS=4

# เครื่องมือที่ Claude ใช้ได้ — ปล่อยว่าง = ใช้ DEFAULT_TOOLS ใน bot.py (ค้นเว็บ อ่านไฟล์ Skill yfinance context7 แก้/ลบไฟล์ไม่ได้)
# ใส่ค่า = ทับค่าเริ่มต้นทั้งหมด
ALLOWED_TOOLS=
# MCP ที่บอทโหลด คั่นด้วย , (ค่าเริ่ม yfinance,context7) ใส่ none = ไม่โหลด
BOT_MCP_SERVERS=
# โฟลเดอร์ที่ Claude อ่านได้เพิ่ม คั่นด้วย ; เช่น C:\Users\me\OneDrive\Desktop\DSSU
EXTRA_READ_DIRS=

# ไม่บังคับ: เลือกโมเดล (เช่น sonnet, opus) ว่าง = ตามค่าเริ่มต้นของ Claude Code
CLAUDE_MODEL=
# เวลาสูงสุดต่อคำถาม (วินาที)
CLAUDE_TIMEOUT=900
# ข้อความยาวแบ่งได้กี่ข้อความ เกินนี้ส่งส่วนแรก + ไฟล์ .md
MAX_MESSAGE_PARTS=6
# ถ้าหา claude ไม่เจอ ใส่ path เต็ม
CLAUDE_BIN=
